# Development/testing: preserve the local demo and mock authentication.
VITE_BACKEND_PROVIDER=local

# Production-like demo builds require BOTH explicit local mode and this opt-in.
# VITE_ALLOW_LOCAL_SANDBOX=true

# Staging/production: set VITE_BACKEND_PROVIDER=cloud and supply the project's
# HTTPS origin plus PUBLIC publishable key (sb_publishable_...) or anon JWT.
# These public values are bundled into the frontend; never use a service-role
# JWT, sb_secret_ key or database password here.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Build example: npm run build -- --mode staging
# Missing/invalid cloud config aborts build/startup; it never falls back to demo.
# Legacy JB.env/JB_dev.env fallback is development-only.
