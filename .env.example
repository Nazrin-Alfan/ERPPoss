# 1. Mode Backend: 'cloud' (Supabase Cloud) atau 'local' (In-Memory / Local Sandbox)
VITE_BACKEND_PROVIDER=local

# 2. Supabase Cloud Configuration (Diperlukan jika VITE_BACKEND_PROVIDER=cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
