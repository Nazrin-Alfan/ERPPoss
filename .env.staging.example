# Copy to ignored .env.staging.local or configure equivalent CI build variables.
# PUBLIC project URL and publishable/anon key only; never a service-role key.
# Vite embeds these values in downloadable browser JavaScript.
VITE_BACKEND_PROVIDER=cloud
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ALLOW_LOCAL_SANDBOX=false
RELAYPOS_HTTP_PORT=8080

# docker compose --env-file .env.staging.local build
# docker compose --env-file .env.staging.local up -d
# Rebuild after VITE_* changes; runtime Nginx cannot change the browser bundle.
# Intentional LOCAL demo builds must explicitly set BOTH:
# VITE_BACKEND_PROVIDER=local
# VITE_ALLOW_LOCAL_SANDBOX=true
